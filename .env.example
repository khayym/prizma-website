# Contact / demo form submissions (Web3Forms — https://web3forms.com)
# Create a free access key and paste it here. Without it, forms show the
# success state but do not send anything (useful for local preview).
GATSBY_WEB3FORMS_KEY=

# Cloudflare Turnstile anti-bot captcha (https://dash.cloudflare.com -> Turnstile)
# Add the SITE key here (public). Put the matching SECRET key in your
# Web3Forms dashboard so submissions are verified server-side.
# Without a site key the captcha widget is hidden.
GATSBY_TURNSTILE_SITE_KEY=
